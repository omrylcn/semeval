#!/bin/bash
# Pre-push hook: Run tests before pushing to main/master

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the current branch name
current_branch=$(git branch --show-current)

# Read push details
while read local_ref local_sha remote_ref remote_sha
do
    # Extract the branch name being pushed to
    if [[ $remote_ref =~ refs/heads/(.+) ]]; then
        remote_branch="${BASH_REMATCH[1]}"

        # Check if pushing to main or master
        if [[ "$remote_branch" == "main" ]] || [[ "$remote_branch" == "master" ]]; then
            echo ""
            echo "⚠️  You are pushing to $remote_branch!"
            echo "🔍 Running pre-merge validation..."
            echo ""

            # Run pre-merge checks
            if make pre-merge; then
                echo ""
                echo -e "${GREEN}✅ All checks passed! Proceeding with push...${NC}"
                echo ""
                exit 0
            else
                echo ""
                echo -e "${RED}❌ PRE-MERGE VALIDATION FAILED!${NC}"
                echo ""
                echo "Push to $remote_branch has been blocked."
                echo ""
                echo "Please fix the issues and try again:"
                echo "  1. Fix failing tests or code issues"
                echo "  2. Run: make pre-merge"
                echo "  3. When all checks pass, push again"
                echo ""
                echo "To bypass this check (NOT RECOMMENDED):"
                echo "  git push --no-verify"
                echo ""
                exit 1
            fi
        fi
    fi
done

# Not pushing to main/master, allow push
exit 0
