# SemEval Environment Variables
# ==============================
# Copy this file to .env and customize for your local environment
# .env file is gitignored and won't be committed

# Custom config file path
# CONFIG_PATH=config.prod.yaml

# Model settings
# SEMEVAL_MODEL__NAME=custom-model-name
# SEMEVAL_MODEL__DEVICE=cuda
# SEMEVAL_MODEL__BATCH_SIZE=64

# Output settings
# SEMEVAL_OUTPUT__BASE_DIR=./results
# SEMEVAL_OUTPUT__EXPORT_FORMATS='["json","csv"]'
# SEMEVAL_OUTPUT__SAVE_COMPREHENSIVE_REPORT=false

# Task settings
# SEMEVAL_TASKS__INFORMATION_RETRIEVAL__ENABLED=true
# SEMEVAL_TASKS__INFORMATION_RETRIEVAL__NDCG_AT_K='[1,3,5,10,20]'
# SEMEVAL_TASKS__LINGUISTIC_ROBUSTNESS__MORPHOLOGY_THRESHOLD=0.90

# Logging settings
# SEMEVAL_LOGGING__VERBOSE=true
# SEMEVAL_LOGGING__LEVEL=DEBUG
# SEMEVAL_LOGGING__LOG_DIR=logs
